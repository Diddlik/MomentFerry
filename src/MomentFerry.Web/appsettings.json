{
  "MomentFerry": {
    "DryRun": true,
    "ReconciliationIntervalSeconds": 1800,
    "Authentication": {
      "Enabled": false
    },
    "Automation": {
      "Enabled": true,
      "InitialDelaySeconds": 10,
      "MaxFilesPerSharePerCycle": 200,
      "MaxParallelMetadataReads": 2,
      "AllowFilesystemTimestampFallback": false
    },
    "Mqtt": {
      "Enabled": false,
      "Host": "",
      "Port": 1883,
      "ClientId": "momentferry",
      "BaseTopic": "momentferry",
      "UseTls": false,
      "ReconnectSeconds": 5
    },
    "Database": {
      "Path": "data/momentferry.db"
    },
    "AllowedRoots": [
      "/sources",
      "/destinations"
    ],
    "SourceRoots": [
      "/sources"
    ],
    "DestinationRoots": [
      "/destinations"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
